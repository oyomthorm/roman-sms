# =============================================================================
# Roman SMS — environment template
# =============================================================================
# Copy to .env, fill in real values, chmod 600, chown roman:roman.
#
#   cp deploy/roman-sms.env.example /opt/roman-sms/.env
#   chmod 600 /opt/roman-sms/.env
#   chown roman:roman /opt/roman-sms/.env
#
# The real .env is NEVER committed.
#
# Format rules — systemd's EnvironmentFile parser is strict:
#   - One KEY=value per line
#   - NO "export " prefix (systemd does not understand it)
#   - NO spaces around the =
#   - Quote values that contain spaces
#   - Comments must start with # at the beginning of the line
#
# Boolean convention used throughout this app:
#   BOOLEAN_VARS are compared to the string '1'. Any other value is false.
#   So "1" enables, "0" disables. "true" / "yes" / "on" will NOT work.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — the app refuses to start without these
# -----------------------------------------------------------------------------

# Postgres connection string. Production MUST be Postgres — the wallet's
# balance check uses SELECT ... FOR UPDATE, which SQLite silently ignores.
DATABASE_URL=postgresql+psycopg://roman:CHANGE_ME@127.0.0.1:5432/roman_sms

# Used for: session cookies, signed opt-out links, password-reset tokens.
# Changing this invalidates every active session and every outstanding
# opt-out / reset link in the wild. Generate once, store safely.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_HEX_CHARS

# Token embedded in the Pahappa delivery webhook URL:
#   POST /api/webhooks/transaction-status/<WEBHOOK_TOKEN>
# Register the full URL in the Pahappa portal. Any mismatch returns 404.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=CHANGE_ME

# No trailing slash. Must be https in production — this is the base for
# every opt-out link that ships in outbound SMS.
PUBLIC_BASE_URL=https://romansms.co.ug


# -----------------------------------------------------------------------------
# Pahappa / EgoSMS
# -----------------------------------------------------------------------------
# Live credentials are issued by Pahappa support — there is no self-service
# signup. Sandbox credentials are separate and only work against the sandbox
# endpoint. Store both sets and toggle with EGOSMS_SANDBOX.
EGOSMS_USERNAME=CHANGE_ME
EGOSMS_PASSWORD=CHANGE_ME
EGOSMS_DEFAULT_SENDER=ROMANSMS
EGOSMS_API_MODE=json
EGOSMS_TIMEOUT=20

# '1' = sandbox endpoint, '0' = live. MUST be '0' in production.
EGOSMS_SANDBOX=0

# API hard limit. Do not raise above 1000.
EGOSMS_BATCH_MAX=1000


# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
# Seconds between polling ticks when the queue is empty.
WORKER_POLL_SECONDS=5

# Messages per batch. Bounded by EGOSMS_BATCH_MAX and per-org rate limits.
WORKER_BATCH_SIZE=200

# Seconds to sleep between batches. 0 = no pause. Keep small (0.1–0.5) in
# production to avoid tripping Pahappa's per-second limits.
WORKER_SEND_INTERVAL=0.3


# -----------------------------------------------------------------------------
# Scheduler
# -----------------------------------------------------------------------------
# Offset from UTC for recurring campaigns, in hours. Uganda = EAT = UTC+3
# year-round, no DST.
SCHEDULER_TZ_OFFSET_HOURS=3


# -----------------------------------------------------------------------------
# Self-signup
# -----------------------------------------------------------------------------
# '1' = public signup form live. '0' = /signup returns 404.
SIGNUP_ENABLED=1

# Starter credits granted on every approved signup request.
SIGNUP_STARTER_CREDITS=100


# -----------------------------------------------------------------------------
# Mailer
# -----------------------------------------------------------------------------
# 'console' logs emails to stdout (dev). 'smtp' sends for real (production).
MAIL_BACKEND=smtp

# Only used when MAIL_BACKEND=smtp.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=no-reply@romansms.co.ug

# Master is notified here on every new signup request. Also used by
# scripts/reconcile.py on wallet drift.
ALERT_EMAIL=you@romansms.co.ug


# -----------------------------------------------------------------------------
# Payment instructions shown on unpaid invoices
# -----------------------------------------------------------------------------
# Multi-line strings are not supported by systemd's EnvironmentFile parser.
# Keep this on one line. The default in config.py is used if omitted.
PAYMENT_INSTRUCTIONS=Pay via MTN MoMo to 0772 123456 or bank transfer to Stanbic 1234567890 (Roman SMS Ltd). Use your invoice number as the payment reference.


# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
# Directory for scripts/backup.py. Relative paths resolve from WorkingDirectory.
BACKUP_DIR=/var/backups/roman-sms
BACKUP_KEEP=30


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# 'text' = human-readable (dev). 'json' = structured (production, feeds journald).
LOG_FORMAT=json
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Master seed — used ONLY by scripts/seed.py on first run
# -----------------------------------------------------------------------------
# Override before running `flask seed-all`. If you leave these as-is, the
# master admin account will be created with password 'ChangeMe123!' — which
# you must change immediately after first login. Better: set a strong one
# here, run the seed, then treat this file as compromised and rotate.
MASTER_EMAIL=admin@romansms.co.ug
MASTER_PASSWORD=CHANGE_ME_STRONG_PASSWORD


# =============================================================================
# Reference — hardcoded in config.py, cannot be overridden via env
# =============================================================================
# MAX_BRAND_PREFIX_CHARS = 20
# SMS_SEGMENT_CHARS      = 160
#
# Setting these here has no effect. To change them, edit config.py.
# =============================================================================

# -----------------------------------------------------------------------------
# Company details shown on generated invoice PDFs
# -----------------------------------------------------------------------------
# These appear in the header of every invoice the associate downloads.
# Leave any blank to omit it from the PDF.
COMPANY_NAME=Roman SMS Ltd
COMPANY_ADDRESS=Plot 12, Kampala Road, Kampala, Uganda
COMPANY_PHONE=+256 760 078601
COMPANY_EMAIL=billing@romansms.co.ug
COMPANY_TIN=1001234567

# '1' = email the campaign creator and org admins when a campaign finishes.
EMAIL_ON_CAMPAIGN_COMPLETE=1