# Normalize line endings to LF (deploy target is Linux)
* text=auto eol=lf

*.sh      text eol=lf
*.service text eol=lf
*.nginx   text eol=lf
*.conf    text eol=lf

*.py      text eol=lf
*.pyi     text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.toml    text eol=lf

*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf

*.md      text eol=lf

# Do not normalize CSV (data files)
*.csv     -text

# Windows-native line endings for Windows-only files
*.bat     text eol=crlf
*.ps1     text eol=crlf
